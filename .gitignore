# Dependencies and build output (conventional names, not decisions)
node_modules/
dist/
build/
.cache/
tmp/
*.tsbuildinfo

# Test and tool output
coverage/
test-results/
playwright-report/
playwright/.cache/

# Secrets and local configuration; example files stay tracked
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
*service-account*.json

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editors
.idea/
*.iml

# Packaged binaries are released elsewhere, not committed
*.apk
*.aab

{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "noUncheckedIndexedAccess": true, "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tools", "vite.config.ts", "playwright.config.ts", "tests"]
}
